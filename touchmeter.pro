QT += core gui dbus
CONFIG += c++17 release link_pkgconfig
PKGCONFIG += libdrm wayland-client xkbcommon libevdev
TARGET = touchmeter
TEMPLATE = app
SOURCES += src/main.cpp src/backend.cpp src/lease.cpp src/appearance.cpp $$OUT_PWD/generated/drm-lease-protocol.c
SOURCES += $$OUT_PWD/generated/idle-notify-protocol.c
SOURCES += src/touchinput.cpp src/controls.cpp $$OUT_PWD/generated/virtual-keyboard-protocol.c
SOURCES += src/session.cpp
SOURCES += src/runeui.cpp
SOURCES += src/testdata.cpp
SOURCES += src/burnrate.cpp
SOURCES += src/appconfig.cpp
SOURCES += src/volume.cpp
SOURCES += src/simulator.cpp
HEADERS += src/backend.h src/lease.h src/appearance.h $$OUT_PWD/generated/drm-lease-client.h
HEADERS += $$OUT_PWD/generated/idle-notify-client.h
HEADERS += src/touchinput.h src/controls.h $$OUT_PWD/generated/virtual-keyboard-client.h
HEADERS += src/session.h
HEADERS += src/runeui.h
HEADERS += src/testdata.h
HEADERS += src/burnrate.h
HEADERS += src/appconfig.h
HEADERS += src/volume.h
HEADERS += src/simulator.h
LIBS += $$PWD/ui/target/release/libtouchmeter_ui.a -ldl -lpthread -lm
PRE_TARGETDEPS += $$PWD/ui/target/release/libtouchmeter_ui.a
INCLUDEPATH += $$OUT_PWD/generated
RESOURCES += src/resources.qrc
