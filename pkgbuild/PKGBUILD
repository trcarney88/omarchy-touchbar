pkgname=touchmeter
pkgver=0.8.0
pkgrel=1
pkgdesc='Rust Rune Touch Bar apps: AI usage, function keys, and volume control'
arch=('aarch64')
license=('MIT')
depends=('wayland' 'libxkbcommon' 'fontconfig' 'omarchy' 'brightnessctl' 'vulkan-icd-loader' 'wireplumber')
makedepends=('rust' 'cargo' 'pkgconf')
options=('!debug')
build() {
  cd "$startdir/.."
  cargo build --locked --release --features linux-hardware
}
package() {
  cd "$startdir/.."
  install -Dm755 target/release/touchmeter "$pkgdir/usr/bin/touchmeter"
  install -Dm644 pkgbuild/touchmeter.desktop "$pkgdir/usr/share/applications/touchmeter.desktop"
  install -Dm644 pkgbuild/touchmeter.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/touchmeter.svg"
  install -Dm644 pkgbuild/touchmeter.service "$pkgdir/usr/lib/systemd/user/touchmeter.service"
  install -Dm644 pkgbuild/65-touchmeter.rules "$pkgdir/usr/lib/udev/rules.d/65-touchmeter.rules"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/touchmeter/LICENSE"
  install -Dm644 ui/LICENSE.rune "$pkgdir/usr/share/licenses/touchmeter/LICENSE.rune"
  install -Dm644 ui/assets/LICENSE.omarchy "$pkgdir/usr/share/licenses/touchmeter/LICENSE.omarchy"
  install -Dm644 protocols/virtual-keyboard-unstable-v1.xml "$pkgdir/usr/share/licenses/touchmeter/virtual-keyboard-unstable-v1.xml"
}
