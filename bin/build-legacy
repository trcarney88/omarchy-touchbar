#!/bin/sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cargo build --locked --release --manifest-path "$ROOT/ui/Cargo.toml" -j2
mkdir -p "$ROOT/build/generated"
PROTO=/usr/share/wayland-protocols/staging/drm-lease/drm-lease-v1.xml
wayland-scanner client-header "$PROTO" "$ROOT/build/generated/drm-lease-client.h"
wayland-scanner private-code "$PROTO" "$ROOT/build/generated/drm-lease-protocol.c"
IDLE=/usr/share/wayland-protocols/staging/ext-idle-notify/ext-idle-notify-v1.xml
wayland-scanner client-header "$IDLE" "$ROOT/build/generated/idle-notify-client.h"
wayland-scanner private-code "$IDLE" "$ROOT/build/generated/idle-notify-protocol.c"
KEYBOARD="$ROOT/protocols/virtual-keyboard-unstable-v1.xml"
wayland-scanner client-header "$KEYBOARD" "$ROOT/build/generated/virtual-keyboard-client.h"
wayland-scanner private-code "$KEYBOARD" "$ROOT/build/generated/virtual-keyboard-protocol.c"
cd "$ROOT/build"
qmake6 "$ROOT/touchmeter.pro"
make -j2
