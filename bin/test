#!/bin/sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cargo build --locked --release --manifest-path "$ROOT/ui/Cargo.toml" -j2
cargo test --locked --release --manifest-path "$ROOT/ui/Cargo.toml" -j2
python3 "$ROOT/tests/test_credentials.py"
"$ROOT/bin/build"
python3 "$ROOT/tests/test_cli.py"
python3 "$ROOT/tests/test_config.py"
mkdir -p "$ROOT/build/tests"
cd "$ROOT/build/tests"
qmake6 "$ROOT/tests/touchmeter_tests.pro"
make -j2
QT_QPA_PLATFORM=offscreen QT_FORCE_STDERR_LOGGING=1 ./touchmeter_tests
